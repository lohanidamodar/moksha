{
	"name": "moksha",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"render": "node src/cli.js render",
		"test": "node --test \"src/**/*.test.js\"",
		"moksha": "node src/cli.js",
		"vendor:fonts": "node scripts/vendor-fonts.mjs"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"svelte": "^5.55.2",
		"vite": "^8.0.7",
		"vite-node": "^6.0.0"
	},
	"dependencies": {
		"@napi-rs/canvas": "^0.1.97",
		"@sveltejs/adapter-node": "^5.5.4",
		"file-saver": "^2.0.5",
		"jszip": "^3.10.1"
	},
	"description": "Store assets for a mobile app: screenshots, feature graphics, promo banners and social cards, for the App Store and Google Play.",
	"license": "MIT",
	"bin": {
		"moksha": "src/cli.js"
	},
	"engines": {
		"node": ">=20.12.0"
	},
	"files": [
		"src/",
		"build/",
		"assets/",
		"README.md",
		"LICENSE"
	],
	"keywords": [
		"app-store",
		"google-play",
		"screenshots",
		"feature-graphic",
		"store-assets",
		"flutter"
	]
}
